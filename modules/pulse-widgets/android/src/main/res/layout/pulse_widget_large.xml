<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome (background, wordmark, configure) is XML with @color resources, so the launcher re-themes it. Everything with
     Pulse type is a bitmap drawn in light and dark (PulseWidgetProvider: setIcon on Android 12+). Spacing must match
     widgetViews in PulseWidgetProvider.kt: 12 padding, 20 header, 8 gap, body, 6 gap, 14 footer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/pulse_widget_background">
  <FrameLayout android:layout_width="match_parent" android:layout_height="20dp">
    <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:src="@drawable/pulse_widget_wordmark" android:contentDescription="@string/pulse_widget_brand"/>
    <ImageView android:id="@+id/widget_configure" android:layout_width="40dp" android:layout_height="match_parent" android:layout_gravity="end" android:scaleType="fitEnd" android:src="@drawable/pulse_widget_more" android:contentDescription="@string/pulse_widget_configure"/>
  </FrameLayout>
  <LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="vertical">
    <LinearLayout android:layout_height="0dp" android:layout_weight="42" android:layout_width="match_parent" android:orientation="horizontal">
      <FrameLayout android:id="@+id/widget_cell_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:importantForAccessibility="yes"><ImageView android:id="@+id/widget_art_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/></FrameLayout>
      <FrameLayout android:id="@+id/widget_cell_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:importantForAccessibility="yes"><ImageView android:id="@+id/widget_art_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/></FrameLayout>
      <FrameLayout android:id="@+id/widget_cell_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:importantForAccessibility="yes"><ImageView android:id="@+id/widget_art_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/></FrameLayout>
    </LinearLayout>
    <ImageView android:id="@+id/widget_heart_card" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="33" android:layout_marginTop="8dp" android:scaleType="fitCenter" android:importantForAccessibility="yes"/>
    <LinearLayout android:layout_height="0dp" android:layout_weight="25" android:layout_marginTop="8dp" android:layout_width="match_parent" android:orientation="horizontal">
      <FrameLayout android:id="@+id/widget_cell_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:importantForAccessibility="yes"><ImageView android:id="@+id/widget_art_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/></FrameLayout>
      <FrameLayout android:id="@+id/widget_cell_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:importantForAccessibility="yes"><ImageView android:id="@+id/widget_art_5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/></FrameLayout>
      <FrameLayout android:id="@+id/widget_cell_6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:importantForAccessibility="yes"><ImageView android:id="@+id/widget_art_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/></FrameLayout>
    </LinearLayout>
  </LinearLayout>
  <ImageView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginTop="6dp" android:scaleType="fitCenter" android:contentDescription="@string/pulse_widget_open"/>
</LinearLayout>
