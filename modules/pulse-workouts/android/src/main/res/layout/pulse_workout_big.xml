<?xml version="1.0" encoding="utf-8"?>
<!-- The expanded live-workout notification and lock-screen card, after WHOOP's: the activity and ♥ bpm, the elapsed
     time large in Strain blue, then the zone bar with its labels (docs/workout-tracker/whoop-ui.md). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/pulse_workout_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
      <TextView android:id="@+id/pulse_workout_bpm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textStyle="bold" />
    </LinearLayout>
    <Chronometer android:id="@+id/pulse_workout_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/pulse_workout_strain" android:textStyle="bold" android:fontFeatureSettings="tnum" android:layout_marginTop="2dp" android:textSize="34sp" />
    <LinearLayout android:id="@+id/pulse_workout_zones" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
      <ImageView android:id="@+id/pulse_workout_zone0" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1"  />
      <ImageView android:id="@+id/pulse_workout_zone1" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginStart="3dp" />
      <ImageView android:id="@+id/pulse_workout_zone2" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginStart="3dp" />
      <ImageView android:id="@+id/pulse_workout_zone3" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginStart="3dp" />
      <ImageView android:id="@+id/pulse_workout_zone4" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginStart="3dp" />
      <ImageView android:id="@+id/pulse_workout_zone5" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginStart="3dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/pulse_workout_labels" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
      <TextView android:id="@+id/pulse_workout_label0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:maxLines="1"  />
      <TextView android:id="@+id/pulse_workout_label1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:maxLines="1" android:layout_marginStart="3dp" />
      <TextView android:id="@+id/pulse_workout_label2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:maxLines="1" android:layout_marginStart="3dp" />
      <TextView android:id="@+id/pulse_workout_label3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:maxLines="1" android:layout_marginStart="3dp" />
      <TextView android:id="@+id/pulse_workout_label4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:maxLines="1" android:layout_marginStart="3dp" />
      <TextView android:id="@+id/pulse_workout_label5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="10sp" android:maxLines="1" android:layout_marginStart="3dp" />
    </LinearLayout>
</LinearLayout>
